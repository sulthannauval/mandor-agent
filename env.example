# Copy to ~/.config/mandor/env (install.sh does this once) and fill in. Never commit the filled file.
# The router serves both an OpenAI-style and an Anthropic-style (/v1/messages) endpoint; 9router does.
export NINEROUTER_BASE_URL="https://your-router.example.com/v1"
export NINEROUTER_API_KEY="replace-me"
