            ]
          }
        }
      }
    },
    "9router-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "{env:NINEROUTER_BASE_URL}",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "executor-agent": {
          "name": "executor-agent",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8000
            }
          }
        },
        "scout-agent": {
          "name": "scout-agent",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8000
            }
          }
        },
        "coder-agent": {
          "name": "coder-agent",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8000
            }
          }
        },
        "fixer-agent": {
          "name": "fixer-agent",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8000
            }
          }
        },
        "reviewer-agent": {
          "name": "reviewer-agent",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8000
            }
          }
        }
      }
    }
  },
  "model": "9router-anthropic/executor-agent",
  "instructions": [
    "CLAUDE.md",
    "CLAUDE.local.md",
    "@HOME@/.config/mandor/WORKFLOW.md"
  ],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "rm -rf*": "ask",
      "systemctl*": "ask",
      "git push*": "allow",
      "rtk git push*": "allow",
      "git push origin main*": "deny",
      "git push origin HEAD:main*": "deny",
      "git push -f*": "deny",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push * -f": "deny",
      "gh pr merge*": "allow",
      "rtk gh pr merge*": "allow",
      "gh pr merge* --admin*": "deny",
      "gh pr merge* --auto*": "deny",
      "rtk gh pr merge* --admin*": "deny"
    },
    "task": {
      "*": "deny",
      "scout": "allow",
      "coder": "allow",
      "fixer": "allow",
      "reviewer": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "edit": {
          "*": "deny",
          "plans/*": "allow"
        }
      }
    }
  }
}
