// mandor-agent: opencode config for the executor runtime.
// install.sh renders this file to ~/.config/opencode/opencode.jsonc (replacing @HOME@).
// The router URL and key come from ~/.config/mandor/env (NINEROUTER_BASE_URL, NINEROUTER_API_KEY).
// Provider "9router-anthropic" holds the five role combos; create them in your router with the same names.
// Provider "9router" lists single models for manual picks; edit it to match what your router serves.
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:NINEROUTER_BASE_URL}",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "alitp-intl/deepseek-v4-pro": {
          "name": "alitp-intl/deepseek-v4-pro",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "alitp-intl/deepseek-v4.1-flash": {
          "name": "alitp-intl/deepseek-v4.1-flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "alitp-intl/glm-5.2": {
          "name": "alitp-intl/glm-5.2",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "alitp-intl/qwen3.6-flash": {
          "name": "alitp-intl/qwen3.6-flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "alitp-intl/qwen3.7-max": {
          "name": "alitp-intl/qwen3.7-max",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "alitp-intl/qwen3.7-plus": {
          "name": "alitp-intl/qwen3.7-plus",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "alitp-intl/qwen3.8-max": {
          "name": "alitp-intl/qwen3.8-max",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "alitp-intl/qwen3.8-max-preview": {
          "name": "alitp-intl/qwen3.8-max-preview",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm/glm-4.6v": {
          "name": "glm/glm-4.6v",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm/glm-4.7": {
          "name": "glm/glm-4.7",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm/glm-5": {
          "name": "glm/glm-5",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
