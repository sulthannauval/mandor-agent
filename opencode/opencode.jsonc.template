            ]
          }
        },
        "glm/glm-5.3": {
          "name": "glm/glm-5.3",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm/glm-5.3-flash": {
          "name": "glm/glm-5.3-flash",
          "modalities": {
            "input": [
